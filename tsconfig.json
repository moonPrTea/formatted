{
  "extends": "gts/tsconfig-google.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "build",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "composite": false,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx"
  },
  "include": [
    "scripts/**/*.ts",
    "scripts/**/*.cts",
    "sheets/electron/**/*.ts",
    "sheets/electron/**/*.cts",
    "sheets/scripts/**/*.ts",
    "formatted/electron/**/*.ts",
    "formatted/electron/**/*.cts",
    "studio/electron/**/*.ts",
    "studio/electron/**/*.cts"
  ]
}
