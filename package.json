{
  "name": "formatted",
  "productName": "formatted",
  "version": "0.1.0",
  "private": true,
  "description": "Offline, concept-first database exam practice",
  "type": "module",
  "main": "build/formatted/electron/start.js",
  "scripts": {
    "predoctor": "npm run build",
    "doctor": "node build/scripts/doctor.js",
    "build": "tsc && tsc -p tsconfig.renderer.json && node build/scripts/copy-assets.js && node scripts/build-ui.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "lint": "gts lint \"scripts/**/*.{ts,cts}\" \"sheets/**/*.{ts,tsx,cts}\" \"packages/spreadsheet/src/**/*.ts\" \"packages/ui/**/*.{ts,tsx}\" \"packages/practice/src/**/*.ts\" \"packages/contracts/**/*.ts\" \"formatted/**/*.{ts,tsx,cts}\" \"studio/**/*.{ts,tsx,cts}\" eslint.config.js",
    "fix": "gts fix \"scripts/**/*.{ts,cts}\" \"sheets/**/*.{ts,tsx,cts}\" \"packages/spreadsheet/src/**/*.ts\" \"packages/ui/**/*.{ts,tsx}\" \"packages/practice/src/**/*.ts\" \"packages/contracts/**/*.ts\" \"formatted/**/*.{ts,tsx,cts}\" \"studio/**/*.{ts,tsx,cts}\" eslint.config.js",
    "format": "prettier --write \"scripts/**/*.{ts,cts}\" \"tests/**/*.{js,cjs}\" \"sheets/**/*.{ts,tsx,cts,css,html,js,cjs,mjs}\" \"packages/spreadsheet/**/*.{ts,js,md}\" \"packages/ui/**/*.{ts,tsx,js,css,md}\" \"packages/practice/**/*.{ts,md}\" \"packages/contracts/**/*.{ts,md}\" \"formatted/**/*.{ts,tsx,cts,css,html,js,cjs,mjs}\" \"studio/**/*.{ts,tsx,cts,js,cjs,mjs,css,html}\" *.json eslint.config.js",
    "check": "npm run typecheck && npm run lint && npm test",
    "prestart": "npm run build",
    "start": "electron .",
    "prepreview": "npm run build",
    "preview": "node build/scripts/preview.js",
    "pretest": "npm run build",
    "test": "node scripts/test.mjs",
    "pretest:engine": "npm run build",
    "test:engine": "node --test packages/spreadsheet/tests/spreadsheet.test.js",
    "pretest:sheets": "npm run build",
    "pretest:ui": "npm run build",
    "test:ui": "node scripts/test-ui.mjs",
    "test:sheets": "node scripts/test-ui.mjs sheets-desktop.cjs wizard-desktop.cjs range-desktop.cjs documents-desktop.cjs editing-desktop.cjs",
    "prebench:engine": "npm run build",
    "bench:engine": "node build/sheets/scripts/benchmark.js",
    "pretest:desktop": "npm run build",
    "test:desktop": "electron formatted/tests/desktop.cjs",
    "pretest:startup": "npm run build",
    "test:startup": "electron formatted/tests/startup.cjs",
    "preicons": "npm run build",
    "icons": "electron build/scripts/build-icons.cjs",
    "prepackage": "npm run build",
    "prepackage:preview": "npm run build",
    "package:preview": "node scripts/package-preview.mjs",
    "package": "electron-packager . formatted --out=release --icon=packages/ui/assets/forma --ignore=\"^/(tests|scripts|src|formatted|sheets|packages|studio|release|desktop-tools|source-package|\\.analysis|\\.git|\\.idea)(/|$)\"",
    "studio:service": "node studio/scripts/build-service.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "44.9.3",
    "gts": "^7.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  },
  "overrides": {
    "tmp": "^0.2.6"
  },
  "dependencies": {
    "@heroui/react": "^3.2.7",
    "@heroui/styles": "^3.2.7",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5"
  }
}
