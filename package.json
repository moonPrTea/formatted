{
  "name": "formatted",
  "productName": "formatted",
  "version": "0.1.0",
  "private": true,
  "description": "Offline, concept-first database exam practice",
  "type": "module",
  "main": "build/electron/start.cjs",
  "scripts": {
    "predoctor": "npm run build",
    "doctor": "node build/scripts/doctor.js",
    "build": "tsc && node build/scripts/copy-assets.js",
    "typecheck": "tsc --noEmit",
    "lint": "gts lint \"src/**/*.ts\" \"electron/**/*.cts\" \"scripts/**/*.{ts,cts}\" eslint.config.js",
    "fix": "gts fix \"src/**/*.ts\" \"electron/**/*.cts\" \"scripts/**/*.{ts,cts}\" eslint.config.js",
    "format": "prettier --write \"src/**/*.{ts,css,html}\" \"electron/**/*.cts\" \"scripts/**/*.{ts,cts}\" \"tests/**/*.{js,cjs}\" *.json eslint.config.js",
    "check": "npm run typecheck && npm run lint && npm test",
    "prestart": "npm run build",
    "start": "electron .",
    "prepreview": "npm run build",
    "preview": "node build/scripts/preview.js",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.js",
    "pretest:engine": "npm run build",
    "test:engine": "node --test tests/spreadsheet.test.js",
    "pretest:sheets": "npm run build",
    "pretest:ui": "npm run build",
    "test:ui": "node scripts/test-ui.mjs",
    "test:sheets": "electron tests/sheets-desktop.cjs && electron tests/wizard-desktop.cjs && electron tests/range-desktop.cjs && electron tests/documents-desktop.cjs && electron tests/editing-desktop.cjs",
    "prebench:engine": "npm run build",
    "bench:engine": "node build/scripts/benchmark-spreadsheet.js",
    "pretest:desktop": "npm run build",
    "test:desktop": "electron tests/desktop.cjs",
    "pretest:startup": "npm run build",
    "test:startup": "electron tests/startup.cjs",
    "preicons": "npm run build",
    "icons": "electron build/scripts/build-icons.cjs",
    "prepackage": "npm run build",
    "prepackage:preview": "npm run build",
    "package:preview": "node scripts/package-preview.mjs",
    "package": "electron-packager . formatted --out=release --icon=src/assets/forma --ignore=\"^/(tests|scripts|src|release|desktop-tools|source-package|\\.analysis|\\.git|\\.idea)(/|$)\""
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "^26.6.4",
    "electron": "44.9.3",
    "gts": "^7.0.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "tmp": "^0.2.6"
  }
}
