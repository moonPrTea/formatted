{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx"
  },
  "include": [
    "sheets/app/**/*.ts",
    "sheets/app/**/*.tsx",
    "packages/spreadsheet/src/**/*.ts",
